<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vikash M — Portfolio</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=Syne:wght@400;600;700;800&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #080c10;
    --bg2: #0d1117;
    --green: #00f5a0;
    --pink: #ff2d78;
    --cyan: #00d4ff;
    --purple: #b14aed;
    --text: #e8f0fe;
    --muted: #6b7280;
    --card: rgba(255,255,255,0.04);
    --border: rgba(255,255,255,0.07);
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Inter', sans-serif;
    overflow-x: hidden;
    cursor: none;
  }

  /* Custom cursor */
  .cursor {
    width: 12px; height: 12px;
    background: var(--green);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none;
    z-index: 9999;
    transition: transform 0.1s;
    mix-blend-mode: screen;
  }
  .cursor-ring {
    width: 36px; height: 36px;
    border: 1px solid var(--green);
    border-radius: 50%;
    position: fixed; top: 0; left: 0;
    pointer-events: none;
    z-index: 9998;
    opacity: 0.5;
    transition: all 0.15s ease;
  }

  /* Stars */
  .stars {
    position: fixed; inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .star {
    position: absolute;
    background: white;
    border-radius: 50%;
    animation: twinkle var(--d, 3s) infinite var(--delay, 0s);
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0.1; }
    50% { opacity: 0.8; }
  }

  /* Noise overlay */
  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.035'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 1;
    opacity: 0.4;
  }

  /* Nav */
  nav {
    position: fixed; top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 1.2rem 3rem;
    display: flex; justify-content: space-between; align-items: center;
    backdrop-filter: blur(20px);
    background: rgba(8,12,16,0.8);
    border-bottom: 1px solid var(--border);
  }
  .nav-logo {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: 1.4rem;
    color: var(--green);
    letter-spacing: 2px;
  }
  .nav-links {
    display: flex; gap: 2.5rem;
    list-style: none;
  }
  .nav-links a {
    color: var(--muted);
    text-decoration: none;
    font-family: 'Space Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    transition: color 0.3s;
    position: relative;
  }
  .nav-links a::before {
    content: attr(data-num);
    color: var(--green);
    margin-right: 6px;
    font-size: 0.65rem;
  }
  .nav-links a:hover { color: var(--text); }

  /* Sections */
  section {
    position: relative;
    z-index: 2;
  }

  /* HERO */
  #hero {
    min-height: 100vh;
    display: flex; align-items: center;
    padding: 8rem 3rem 4rem;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    align-items: center;
  }
  .hero-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.72rem;
    color: var(--green);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
    display: flex; align-items: center; gap: 12px;
  }
  .hero-label::before {
    content: '';
    display: block;
    width: 40px; height: 1px;
    background: var(--green);
  }
  h1 {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(3.5rem, 7vw, 6rem);
    line-height: 1;
    letter-spacing: -2px;
    margin-bottom: 1rem;
  }
  h1 .name-white { color: var(--text); }
  h1 .name-green {
    color: transparent;
    -webkit-text-stroke: 2px var(--green);
  }
  .hero-role {
    font-family: 'Space Mono', monospace;
    font-size: 0.85rem;
    color: var(--cyan);
    letter-spacing: 2px;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
  }
  .hero-desc {
    color: var(--muted);
    line-height: 1.8;
    font-size: 0.95rem;
    max-width: 480px;
    margin-bottom: 2.5rem;
  }
  .hero-btns {
    display: flex; gap: 1rem; flex-wrap: wrap;
  }
  .btn-primary {
    padding: 0.8rem 2rem;
    background: var(--green);
    color: #000;
    font-family: 'Space Mono', monospace;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-decoration: none;
    border: none;
    cursor: none;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
    transition: all 0.3s;
    text-transform: uppercase;
  }
  .btn-primary:hover {
    background: var(--cyan);
    transform: translateY(-2px);
  }
  .btn-outline {
    padding: 0.8rem 2rem;
    background: transparent;
    color: var(--text);
    font-family: 'Space Mono', monospace;
    font-size: 0.78rem;
    letter-spacing: 1px;
    text-decoration: none;
    border: 1px solid var(--border);
    cursor: none;
    transition: all 0.3s;
    text-transform: uppercase;
    clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 10px 100%, 0 calc(100% - 10px));
  }
  .btn-outline:hover {
    border-color: var(--green);
    color: var(--green);
  }

  /* Orbiting avatar */
  .hero-visual {
    display: flex; justify-content: center; align-items: center;
    position: relative;
  }
  .orbit-container {
    position: relative;
    width: 320px; height: 320px;
  }
  .orbit-ring {
    position: absolute; inset: 0;
    border-radius: 50%;
    border: 1px dashed rgba(0,245,160,0.2);
    animation: spin var(--speed, 12s) linear infinite;
  }
  .orbit-ring:nth-child(2) {
    inset: 25px;
    border-color: rgba(0,212,255,0.15);
    animation-direction: reverse;
    --speed: 8s;
  }
  @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

  .orbit-dot {
    position: absolute;
    width: 10px; height: 10px;
    border-radius: 50%;
    top: -5px; left: 50%;
    margin-left: -5px;
  }
  .orbit-ring:nth-child(1) .orbit-dot { background: var(--green); box-shadow: 0 0 12px var(--green); }
  .orbit-ring:nth-child(2) .orbit-dot { background: var(--pink); box-shadow: 0 0 12px var(--pink); }

  .avatar-center {
    position: absolute;
    inset: 60px;
    border-radius: 50%;
    background: var(--bg2);
    border: 2px solid rgba(0,245,160,0.3);
    display: flex; align-items: center; justify-content: center;
    font-size: 4rem;
    box-shadow: 0 0 60px rgba(0,245,160,0.1), inset 0 0 40px rgba(0,245,160,0.05);
  }

  .skill-pill {
    position: absolute;
    font-family: 'Space Mono', monospace;
    font-size: 0.6rem;
    color: var(--green);
    background: rgba(0,245,160,0.08);
    border: 1px solid rgba(0,245,160,0.2);
    padding: 4px 10px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .pill-1 { top: 10px; right: -10px; }
  .pill-2 { bottom: 20px; left: -20px; color: var(--cyan); background: rgba(0,212,255,0.08); border-color: rgba(0,212,255,0.2); }
  .pill-3 { top: 50%; right: -30px; transform: translateY(-50%); color: var(--pink); background: rgba(255,45,120,0.08); border-color: rgba(255,45,120,0.2); }

  /* ABOUT */
  #about {
    padding: 6rem 3rem;
  }
  .section-header {
    display: flex; align-items: center; gap: 1rem;
    margin-bottom: 4rem;
    max-width: 1200px; margin-left: auto; margin-right: auto;
  }
  .section-num {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    color: var(--green);
    letter-spacing: 2px;
  }
  .section-line {
    width: 40px; height: 1px;
    background: var(--green);
    flex-shrink: 0;
  }
  .section-title {
    font-family: 'Syne', sans-serif;
    font-weight: 800;
    font-size: clamp(2.5rem, 5vw, 4rem);
    letter-spacing: -1px;
    line-height: 1;
    margin-bottom: 1rem;
    max-width: 1200px; margin-left: auto; margin-right: auto;
  }
  .about-grid {
    max-width: 1200px;
    margin: 3rem auto 0;
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: start;
  }
  .about-text p {
    color: var(--muted);
    line-height: 1.9;
    font-size: 0.95rem;
    margin-bottom: 1.2rem;
  }
  .about-text p strong {
    color: var(--text);
    font-weight: 500;
  }
  .skills-grid {
    display: flex; flex-wrap: wrap; gap: 0.6rem;
    margin-top: 1.5rem;
  }
  .skill-tag {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    padding: 6px 14px;
    border-radius: 2px;
    border: 1px solid var(--border);
    color: var(--muted);
    transition: all 0.3s;
    cursor: default;
  }
  .skill-tag:hover {
    border-color: var(--green);
    color: var(--green);
    background: rgba(0,245,160,0.05);
  }
  .skill-tag.green { border-color: rgba(0,245,160,0.3); color: var(--green); }
  .skill-tag.cyan { border-color: rgba(0,212,255,0.3); color: var(--cyan); }
  .skill-tag.pink { border-color: rgba(255,45,120,0.3); color: var(--pink); }

  .stats-panel {
    display: flex; flex-direction: column; gap: 1.5rem;
  }
  .stat-card {
    background: var(--card);
    border: 1px solid var(--border);
    padding: 1.5rem;
    position: relative;
    overflow: hidden;
    transition: border-color 0.3s;
  }
  .stat-card::before {
    content: '';
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--green);
  }
  .stat-card:nth-child(2)::before { background: var(--cyan); }
  .stat-card:nth-child(3)::before { background: var(--pink); }
  .stat-card:hover { border-color: rgba(255,255,255,0.15); }
  .stat-num {
    font-family: 'Syne', sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--green);
    line-height: 1;
  }
  .stat-card:nth-child(2) .stat-num { color: var(--cyan); }
  .stat-card:nth-child(3) .stat-num { color: var(--pink); }
  .stat-label {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    color: var(--muted);
    letter-spacing: 1px;
    margin-top: 0.3rem;
    text-transform: uppercase;
  }

  /* SKILLS */
  #skills {
    padding: 6rem 3rem;
    background: linear-gradient(180deg, transparent, rgba(0,245,160,0.02), transparent);
  }
  .skills-bars {
    max-width: 800px;
    margin: 3rem auto 0;
    display: flex; flex-direction: column; gap: 1.8rem;
  }
  .skill-row {
    display: grid;
    grid-template-columns: 160px 1fr 40px;
    gap: 1.5rem;
    align-items: center;
  }
  .skill-name {
    font-family: 'Space Mono', monospace;
    font-size: 0.78rem;
    color: var(--text);
    display: flex; align-items: center; gap: 8px;
  }
  .skill-name .icon { font-size: 1rem; }
  .skill-bar-track {
    height: 4px;
    background: rgba(255,255,255,0.06);
    border-radius: 2px;
    overflow: visible;
    position: relative;
  }
  .skill-bar-fill {
    height: 100%;
    border-radius: 2px;
    transform-origin: left;
    transform: scaleX(0);
    animation: barGrow 1.2s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    position: relative;
  }
  .skill-bar-fill::after {
    content: '';
    position: absolute;
    right: 0; top: 50%;
    transform: translateY(-50%);
    width: 8px; height: 8px;
    border-radius: 50%;
    background: inherit;
    box-shadow: 0 0 10px currentColor;
  }
  .skill-bar-fill.g { background: linear-gradient(90deg, var(--green), var(--cyan)); }
  .skill-bar-fill.p { background: linear-gradient(90deg, var(--purple), var(--pink)); }
  .skill-bar-fill.c { background: linear-gradient(90deg, var(--cyan), var(--green)); }
  .skill-bar-fill.pk { background: linear-gradient(90deg, var(--pink), var(--purple)); }
  .skill-bar-fill.y { background: linear-gradient(90deg, #f0c040, var(--pink)); }

  @keyframes barGrow { to { transform: scaleX(1); } }
  .skill-pct {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    color: var(--muted);
    text-align: right;
  }
  .skill-row:nth-child(1) .skill-bar-fill { animation-delay: 0.1s; }
  .skill-row:nth-child(2) .skill-bar-fill { animation-delay: 0.2s; }
  .skill-row:nth-child(3) .skill-bar-fill { animation-delay: 0.3s; }
  .skill-row:nth-child(4) .skill-bar-fill { animation-delay: 0.4s; }
  .skill-row:nth-child(5) .skill-bar-fill { animation-delay: 0.5s; }

  /* PROJECTS */
  #projects {
    padding: 6rem 3rem;
  }
  .projects-grid {
    max-width: 1200px;
    margin: 3rem auto 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .project-card {
    background: var(--card);
    border: 1px solid var(--border);
    padding: 2rem;
    position: relative;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: none;
  }
  .project-card::before {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(0,245,160,0.05), transparent);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .project-card:hover {
    border-color: rgba(0,245,160,0.25);
    transform: translateY(-6px);
  }
  .project-card:hover::before { opacity: 1; }
  .project-card:nth-child(2) { border-color: rgba(0,212,255,0.1); }
  .project-card:nth-child(2)::before { background: linear-gradient(135deg, rgba(0,212,255,0.05), transparent); }
  .project-card:nth-child(2):hover { border-color: rgba(0,212,255,0.25); }
  .project-card:nth-child(3) { border-color: rgba(255,45,120,0.1); }
  .project-card:nth-child(3)::before { background: linear-gradient(135deg, rgba(255,45,120,0.05), transparent); }
  .project-card:nth-child(3):hover { border-color: rgba(255,45,120,0.25); }
  .project-num {
    font-family: 'Syne', sans-serif;
    font-size: 3.5rem;
    font-weight: 800;
    color: rgba(255,255,255,0.04);
    line-height: 1;
    margin-bottom: 1rem;
  }
  .project-icon { font-size: 1.8rem; margin-bottom: 1rem; }
  .project-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text);
    margin-bottom: 0.8rem;
  }
  .project-desc {
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .project-tags {
    display: flex; flex-wrap: wrap; gap: 0.5rem;
  }
  .ptag {
    font-family: 'Space Mono', monospace;
    font-size: 0.62rem;
    padding: 3px 10px;
    border-radius: 2px;
    border: 1px solid var(--border);
    color: var(--muted);
  }
  .ptag.g { border-color: rgba(0,245,160,0.3); color: var(--green); }
  .ptag.c { border-color: rgba(0,212,255,0.3); color: var(--cyan); }
  .ptag.p { border-color: rgba(255,45,120,0.3); color: var(--pink); }

  /* ACHIEVEMENTS */
  #achievements {
    padding: 6rem 3rem;
    background: linear-gradient(180deg, transparent, rgba(0,212,255,0.02), transparent);
  }
  .ach-grid {
    max-width: 1200px;
    margin: 3rem auto 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .ach-card {
    background: var(--card);
    border: 1px solid var(--border);
    padding: 1.8rem;
    text-align: center;
    transition: all 0.3s;
    cursor: none;
    position: relative;
    overflow: hidden;
  }
  .ach-card::after {
    content: '';
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 2px;
    background: var(--green);
    transform: scaleX(0);
    transition: transform 0.3s;
  }
  .ach-card:nth-child(2)::after { background: var(--cyan); }
  .ach-card:nth-child(3)::after { background: var(--pink); }
  .ach-card:nth-child(4)::after { background: var(--purple); }
  .ach-card:hover::after { transform: scaleX(1); }
  .ach-card:hover { border-color: rgba(255,255,255,0.12); transform: translateY(-4px); }
  .ach-emoji { font-size: 2rem; margin-bottom: 1rem; }
  .ach-title {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .ach-sub {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  /* PROFILES */
  #profiles {
    padding: 6rem 3rem;
  }
  .profiles-row {
    max-width: 900px;
    margin: 3rem auto 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }
  .profile-link {
    background: var(--card);
    border: 1px solid var(--border);
    padding: 1.5rem 1rem;
    text-decoration: none;
    text-align: center;
    transition: all 0.3s;
    cursor: none;
    display: block;
  }
  .profile-link:hover {
    border-color: var(--green);
    transform: translateY(-4px);
  }
  .profile-link:nth-child(2):hover { border-color: var(--cyan); }
  .profile-link:nth-child(3):hover { border-color: var(--pink); }
  .profile-link:nth-child(4):hover { border-color: var(--purple); }
  .profile-icon { font-size: 1.6rem; margin-bottom: 0.6rem; }
  .profile-name {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text);
    margin-bottom: 0.3rem;
  }
  .profile-handle {
    font-family: 'Space Mono', monospace;
    font-size: 0.65rem;
    color: var(--muted);
  }

  /* CONTACT */
  #contact {
    padding: 6rem 3rem 4rem;
    text-align: center;
  }
  .contact-inner {
    max-width: 700px;
    margin: 0 auto;
  }
  .contact-subtitle {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.8;
    margin: 1.5rem 0 2.5rem;
  }
  .contact-details {
    display: flex; gap: 2rem; justify-content: center; flex-wrap: wrap;
    margin-top: 3rem;
  }
  .contact-item {
    font-family: 'Space Mono', monospace;
    font-size: 0.78rem;
    color: var(--muted);
    display: flex; align-items: center; gap: 8px;
  }
  .contact-item span { color: var(--green); }

  /* Footer */
  footer {
    padding: 2rem 3rem;
    border-top: 1px solid var(--border);
    display: flex; justify-content: space-between; align-items: center;
    z-index: 2; position: relative;
  }
  .footer-copy {
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    color: var(--muted);
  }
  .footer-status {
    display: flex; align-items: center; gap: 8px;
    font-family: 'Space Mono', monospace;
    font-size: 0.7rem;
    color: var(--green);
  }
  .status-dot {
    width: 6px; height: 6px;
    background: var(--green);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(0,245,160,0.4); }
    50% { opacity: 0.6; box-shadow: 0 0 0 6px rgba(0,245,160,0); }
  }

  /* Divider */
  .section-divider {
    max-width: 1200px;
    margin: 0 auto;
    height: 1px;
    background: var(--border);
  }

  /* Glowing blobs */
  .blob {
    position: fixed;
    border-radius: 50%;
    filter: blur(120px);
    pointer-events: none;
    z-index: 0;
    animation: blobMove 20s ease-in-out infinite;
  }
  .blob-1 { width: 400px; height: 400px; background: rgba(0,245,160,0.04); top: 10%; left: 60%; }
  .blob-2 { width: 300px; height: 300px; background: rgba(0,212,255,0.04); top: 50%; left: 10%; animation-delay: -7s; }
  .blob-3 { width: 350px; height: 350px; background: rgba(255,45,120,0.03); top: 80%; left: 70%; animation-delay: -14s; }
  @keyframes blobMove {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(30px, -30px); }
    66% { transform: translate(-20px, 20px); }
  }

  /* Scan line */
  .scanline {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--green), transparent);
    opacity: 0.05;
    animation: scan 8s linear infinite;
    pointer-events: none;
    z-index: 50;
  }
  @keyframes scan {
    from { top: -2px; }
    to { top: 100vh; }
  }

  /* Fade in animations */
  .fade-up {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  @keyframes fadeUp {
    to { opacity: 1; transform: translateY(0); }
  }
  .delay-1 { animation-delay: 0.2s; }
  .delay-2 { animation-delay: 0.4s; }
  .delay-3 { animation-delay: 0.6s; }
  .delay-4 { animation-delay: 0.8s; }

  /* Glitch effect on name */
  .glitch {
    position: relative;
  }
  .glitch::before, .glitch::after {
    content: attr(data-text);
    position: absolute; top: 0; left: 0;
    width: 100%;
    font-family: inherit; font-size: inherit; font-weight: inherit;
    clip: rect(0, 900px, 0, 0);
  }
  .glitch::before {
    color: var(--cyan);
    animation: glitch1 4s infinite;
  }
  .glitch::after {
    color: var(--pink);
    animation: glitch2 4s infinite;
  }
